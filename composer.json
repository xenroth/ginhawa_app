{
    "name": "akhzaroth-khan/ginhawa-app",
    "type": "project",
    "description": "Ginhawa decentralized community forum and global organization application.",
    "keywords": ["laravel", "community", "forum", "ginhawa"],
    "license": "MIT",
    "authors": [{"name": "Akhzaroth Khan (Richard C. Cupal, LPT)"}],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.9"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}
    },
    "scripts": {
        "post-autoload-dump": ["@php artisan package:discover --ansi"]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}