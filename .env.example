APP_NAME=GINHAWA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
GINHAWA_VERSION=alpha-release-v.1.0.3
GINHAWA_GITHUB_REPOSITORY=xenroth/ginhawa_app
# Required only when the GitHub repository is private.
GINHAWA_GITHUB_TOKEN=
GINHAWA_XRP_ADDRESS=
GINHAWA_XRP_MEMO=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_cpanel_database_name
DB_USERNAME=your_cpanel_database_user
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync